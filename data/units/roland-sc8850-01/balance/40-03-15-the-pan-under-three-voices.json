  "findings": [
    {
      "kind": "what reaches the output with the effect's own output level at zero, which is the level of any path that does not pass through it -- and the floor that any separation this run reports is against",
      "runs": [
        "level-at-zero"
      ],
      "held": {
        "40 03 03": 64,
        "40 03 04": 64,
        "40 03 05": 64,
        "40 03 06": 64,
        "40 03 07": 64,
        "40 03 08": 64,
        "40 03 09": 64,
        "40 03 0A": 64,
        "40 03 15": 0,
        "40 03 16": 0
      },
      "read_in": "runs[name=level-at-zero].by_setting[].over_the_lead_db",
      "why": "A separation between two channels is the separation of whatever reached them, so a second path to the output that the parameter does not act on would set a floor under it that has nothing to do with the parameter. A run with no two channels to compare is exactly the run that answers whether there is such a path, and reporting it as a refusal alone would publish the answer as a silence. What is reported instead is how far each take stood over its own lead: at the lead there was nothing for a later reading to be the sum of, and above it there was."
    }
  ]
